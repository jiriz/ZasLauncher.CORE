<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <RuntimeIdentifiers>osx-x64;osx-arm64;win-x64</RuntimeIdentifiers>
        <ApplicationManifest Condition="'$(RuntimeIdentifier)' == 'win-x64'">app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <Version>1.0.0.9</Version>
        <AssemblyName>ZasLauncherGUI</AssemblyName>
        <RootNamespace>ZasLauncherGUI</RootNamespace>
    </PropertyGroup>
    <PropertyGroup>
        <PublishSingleFile Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</PublishSingleFile>
        <PublishSingleFile Condition="'$(RuntimeIdentifier)' != 'win-x64'">false</PublishSingleFile>
        <SelfContained>true</SelfContained>
    </PropertyGroup>
    <ItemGroup>
        <None Include="Info.plist" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets/*" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\..\..\ZASproducts\Asnet.Karat\_alfa\ZASutility.Standard\ZASutility.Standard.csproj" />
    </ItemGroup>
</Project>
